{
    // AppConfig — overrides flat scalar defaults from AppConfig constructor
    "AppConfig": {
        "appName": "RegistryDemo",
        "windowWidth": 2560,
        "windowHeight": 1600,
        "fullscreen": false,
        "targetFps": 60.0,
        "uiFontSize": 42.0,
        "uiFontPath": "resources/font/ComicMonoNF-Regular.ttf",
        "logLevel": "debug"
    },
    // RenderSettings — inherits DirtyTracker; dirty() fires on every load
    "RenderSettings": {
        "clearColor": [0.2, 0.2, 0.25, 1.0],
        "wireframe": false,
        "shadowQuality": "high",
        "maxLights": 16
    },
    // NetworkConfig — demonstrates nested sub-object (EndpointInfo)
    "NetworkConfig": {
        "endpoint": {
            "host": "192.168.1.100",
            "port": 9090
        },
        "timeoutMs": 3000,
        "enableTLS": true
    }
}
